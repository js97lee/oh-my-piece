# Client (Vite) — used for Kakao authorize redirect
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Server (Vite middleware / Vercel /api) — token exchange
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Optional override. Default is `${origin}/mypage` so local + production both work.
# VITE_KAKAO_REDIRECT_URI=http://localhost:5173/mypage
