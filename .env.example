# 서비스 주소 — 로컬 실행 포트 또는 운영 HTTPS 도메인
APP_BASE_URL=http://localhost:5173

# 나이스페이 — 같은 상점의 Server 승인 / Basic 인증 키 쌍
# sandbox: 테스트 결제 / production: 실제 결제
NICEPAY_ENV=sandbox
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=

# Supabase Auth — 서버에서만 읽습니다. VITE_ 접두사는 사용하지 않습니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 주문·결제·구독 저장용 서버 비밀키 (일반 로그인에는 사용하지 않음)
SUPABASE_SECRET_KEY=

# 결제 스키마 마이그레이션용 PostgreSQL 연결 주소 (일반 실행 시 불필요)
DATABASE_URL=

# Aligo 알림톡 테스트 — 모두 서버 전용이며 VITE_ 접두사를 붙이지 마세요.
# 기존 등록 정보를 입력하고 서버를 다시 실행합니다.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER_PHONE=

# 테스트 페이지/API 접근 비밀번호. 알리고 비밀번호가 아닌 별도 임의 문자열입니다.
# 예: openssl rand -hex 24
ALIGO_TEST_TOKEN=
